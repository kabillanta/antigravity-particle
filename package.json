{
  "name": "antigravity-particle",
  "version": "1.1.1",
  "description": "An open-source React component featuring the interactive jellyfish particle effect from the Google Antigravity landing page.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./medusae.css": "./dist/medusae.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "three": ">=0.140.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^8.16.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.164.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "react",
    "three",
    "fiber",
    "particle",
    "animation",
    "webgl",
    "medusae",
    "antigravity",
    "google"
  ],
  "author": "",
  "license": "MIT"
}
